# Chave de API Google Gemini (Obrigatório para o modelo 2.5 Flash)
GEMINI_API_KEY=sua_chave_gemini_api_aqui

# Banco de Dados Supabase (Opcional - caso utilize modo Nuvem)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_chave_anonima_supabase

# Porta do Servidor
PORT=4000
